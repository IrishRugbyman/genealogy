# Copy to api/.env (gitignored) and fill in. Every variable is optional; see the
# "Configuration" table in CLAUDE.md for what each one does when unset.

# GENEALOGY_DSN=dbname=genealogy

# Individual id numbered Sosa 1 (e.g. I1). Unset: no Sosa numbering.
GENEALOGY_SOSA_ROOT=

# Names of branch 1 (the root's father's side) and branch 2, comma-separated.
GENEALOGY_BRANCH_LABELS=Paternelle,Maternelle

# The /depot upload page. Both must be set, or uploads answer 503.
GENEALOGY_UPLOAD_PASSWORD=
GENEALOGY_DEPOT_DIR=
